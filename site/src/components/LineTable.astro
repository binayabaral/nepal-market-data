---
/**
 * The accessibility fallback for a single-value (NAV or metal price) chart: prerendered at build
 * time from the same CSV the chart fetches client-side, so it is present with JavaScript disabled
 * and when the chart's fetch fails. Never fetches on its own.
 *
 * Mirrors OhlcTable.astro's conventions (newest-first, capped at 60 rows, dash for missing values,
 * table-wrap, class="num") for a series with one value per day instead of four.
 */
import { formatNumber } from '../lib/format';

interface Props {
  rows: Array<Record<string, string>>;
  valueColumn: string;
  valueLabel: string;
}

const { rows, valueColumn, valueLabel } = Astro.props;

// The CSV is stored oldest-first; the table shows newest-first, capped at the most recent 60 sessions.
const recent = [...rows].reverse().slice(0, 60);

function toNumber(value: string | undefined): number | null {
  if (value === undefined || value === '') return null;
  const n = Number(value);
  return Number.isFinite(n) ? n : null;
}

/** A missing or unparsable value renders as a plain dash, never "NaN". */
function fmtOrDash(value: string | undefined): string {
  const n = toNumber(value);
  return n === null ? '-' : formatNumber(n);
}
---

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th class="num">{valueLabel}</th>
      </tr>
    </thead>
    <tbody>
      {recent.map(row => (
        <tr>
          <td>{row.published_date}</td>
          <td class="num">{fmtOrDash(row[valueColumn])}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
