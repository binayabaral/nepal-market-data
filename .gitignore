node_modules
.env
*.log

# macOS directory metadata. Untracked copies were sitting in the working tree of this public repo,
# one careless `git add -A` away from being published.
.DS_Store

# Local development notes, kept out of this public repo on purpose: they discuss the private
# upstream application these scrapers came from. They must stay on disk (a new session reads them
# to pick up project context) but must never be published here.
.claude/
CLAUDE.md

# Site build artifacts. The manifest and the data copy are generated from data/ on every build,
# and committing 31MB of duplicated CSV into a repo whose whole point is the original would be absurd.
site/node_modules
site/dist
site/.astro
site/public/data
site/src/data/manifest.json
